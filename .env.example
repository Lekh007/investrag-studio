INVESTRAG_DATA_DIR=.data/investrag
INVESTRAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
INVESTRAG_OLLAMA_MODEL=llama3.1:8b
INVESTRAG_EMBEDDING_MODEL=BAAI/bge-m3
INVESTRAG_EMBEDDING_MODE=auto
INVESTRAG_EMBEDDING_FALLBACK_DIMENSION=512
